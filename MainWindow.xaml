<Window x:Class="NativeTavern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NativeTavern" Height="800" Width="1200" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="NativeTavern" FontSize="22" FontWeight="SemiBold" Margin="8,8,0,28" />
                    <Button Content="💬  Chat" HorizontalContentAlignment="Left" Command="{Binding ShowChatCommand}" Margin="0,0,0,10" />
                    <Button Content="👤  Characters" HorizontalContentAlignment="Left" Command="{Binding ShowCharactersCommand}" Margin="0,0,0,10" />
                    <Button Content="⚙  Settings" HorizontalContentAlignment="Left" Command="{Binding ShowSettingsCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="v0.2.0" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
            </DockPanel>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
