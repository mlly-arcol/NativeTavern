<Window x:Class="NativeTavern.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NativeTavern.Helpers"
        Title="欢迎使用 NativeTavern" Width="1020" Height="740" MinWidth="900" MinHeight="700"
        Icon="/NativeTavern;component/Assets/NativeTavern.png"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI" FontSize="14"
        Foreground="{StaticResource TextBrush}" UseLayoutRounding="True">
    <Grid Background="{StaticResource WindowBrush}" Margin="20" helpers:UiMotion.Entrance="True">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border CornerRadius="22" Padding="36">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E9ECFF"/><GradientStop Color="#F0EDFA" Offset="0.55"/><GradientStop Color="#E4F1FA" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Width="42" Height="42" Source="{StaticResource BrandIcon}" Stretch="Uniform" AutomationProperties.Name="NativeTavern"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="NativeTavern" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="你的本地 AI 工作区" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,24">
                    <TextBlock Text="每段对话，&#x0a;都有新的可能。" FontSize="34" FontWeight="SemiBold" LineHeight="48"/>
                    <TextBlock Text="在这里创造角色、整理灵感，&#x0a;开启属于你的 AI 对话空间。" Foreground="{StaticResource MutedTextBrush}" FontSize="15" LineHeight="25" Margin="0,18,0,28"/>
                    <Border Background="#BFFFFFFF" CornerRadius="16" Padding="20" BorderBrush="#DFFFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="一个空间，容纳你的灵感" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,14"/>
                            <TextBlock Text="◉   自由对话，探索新想法" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"/>
                            <TextBlock Text="♙   塑造角色，延续故事" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"/>
                            <TextBlock Text="▤   整理知识，让灵感有迹可循" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="无需账号，也可以先体验本地功能。" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="36,16,16,16" MaxWidth="370" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="欢迎回来" FontSize="29" FontWeight="SemiBold"/>
                    <TextBlock Text="登录账号，继续你的灵感旅程" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,20"/>
                    <Border Background="{StaticResource AccentTintBgBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,20"><TextBlock Text="账号服务尚未开放。当前页面仅校验输入，不会发送或保存邮箱和密码；你可以点击“先体验”进入软件。" FontSize="12" Foreground="{StaticResource AccentTintTextBrush}" TextWrapping="Wrap" LineHeight="19"/></Border>
                    <TextBlock Text="邮箱" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="EmailBox" MinHeight="44" MaxLength="254" AutomationProperties.Name="邮箱" ToolTip="例如 name@example.com" TextChanged="Input_OnChanged"/>
                    <TextBlock x:Name="EmailError" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringToVisibility}}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,14" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="密码" FontWeight="SemiBold" Margin="0,18,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PasswordInput" MinHeight="44" MaxLength="128" AutomationProperties.Name="密码" PasswordChanged="Password_OnChanged"/>
                        <TextBox x:Name="VisiblePassword" Visibility="Collapsed" MinHeight="44" MaxLength="128" AutomationProperties.Name="明文密码" TextChanged="VisiblePassword_OnChanged"/>
                        <Button x:Name="RevealButton" Grid.Column="1" Content="显示" Click="Reveal_OnClick" Margin="8,0,0,0" Padding="10,6" MinWidth="52" AutomationProperties.Name="显示密码"/>
                    </Grid>
                    <TextBlock x:Name="PasswordError" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringToVisibility}}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,8" AutomationProperties.LiveSetting="Polite"/>
                    <Button Content="忘记密码？" HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}" Foreground="{StaticResource AccentBrush}" Click="Forgot_OnClick" Margin="0,8,0,14" Padding="0,4"/>
                    <Button x:Name="LoginButton" Content="登录" IsDefault="True" MinHeight="46" Style="{StaticResource PrimaryButtonStyle}" Margin="0" Click="Login_OnClick"/>
                    <ProgressBar x:Name="LoginProgress" Visibility="Collapsed" IsIndeterminate="True" Height="3" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" AutomationProperties.Name="正在校验输入"/>
                    <TextBlock x:Name="StatusText" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringToVisibility}}" Text="" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,12" AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"><TextBlock Text="还没有账号？" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="13"/><Button Content="注册账号" Style="{StaticResource GhostButtonStyle}" Foreground="{StaticResource AccentBrush}" Padding="6,4" Margin="0" Click="Register_OnClick"/></StackPanel>
                    <Grid Margin="0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Separator VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="或" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="12,0"/><Separator Grid.Column="2" VerticalAlignment="Center"/></Grid>
                    <Button Content="先体验，进入本地工作区 →" MinHeight="44" Margin="0" Click="Experience_OnClick"/>
                    <TextBlock Text="账号服务开放后，将支持真实登录。" HorizontalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
