<UserControl x:Class="NativeTavern.Views.ChatView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:NativeTavern.Controls"
 xmlns:models="clr-namespace:NativeTavern.Models">
 <UserControl.Resources>
  <Style x:Key="MessageActionButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
   <Setter Property="Background" Value="#F7F7F8"/>
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="Margin" Value="0,0,5,0"/>
   <Setter Property="FontSize" Value="11"/>
  </Style>
 </UserControl.Resources>
 <Grid Background="{StaticResource WindowBrush}">
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <!-- Compact conversation header -->
  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding SessionTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="430"/>
      <Button Content="✎" Click="RenameChat_OnClick" Style="{StaticResource GhostButtonStyle}" Padding="5,1" Margin="5,0,0,0"
              ToolTip="Rename conversation" AutomationProperties.Name="Rename conversation"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
      <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBlock Text="Local workspace" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
      <TextBlock Text="  ·  ~" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
      <TextBlock Text="{Binding EstimatedPromptTokens}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
      <TextBlock Text=" tokens" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
      <TextBlock Text="  ·  Branch" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                 Visibility="{Binding IsBranch, Converter={StaticResource BoolToVisibility}}"/>
      <Button Content="返回源对话" Command="{Binding OpenParentConversationCommand}" Style="{StaticResource GhostButtonStyle}"
              Padding="5,0" Margin="5,0,0,0" FontSize="11" AutomationProperties.Name="Open source conversation"
              Visibility="{Binding IsBranch, Converter={StaticResource BoolToVisibility}}"/>
     </StackPanel>
    </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="成员" Click="EditGroupChat_OnClick" Margin="0,0,8,0" ToolTip="管理群聊成员"
              Visibility="{Binding IsGroupChat, Converter={StaticResource BoolToVisibility}}"/>
      <Button Content="下一位 ▾" Click="NextSpeaker_OnClick" Margin="0,0,8,0" ToolTip="自动选择或指定下一位发言角色"
              Visibility="{Binding IsGroupChat, Converter={StaticResource BoolToVisibility}}"/>
      <ComboBox Width="230" Height="38" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" DisplayMemberPath="Title" Margin="0,0,8,0" ToolTip="Switch conversation"/>
     <Button Content="⚙ 对话设置" Click="PromptSettings_OnClick" Margin="0,0,8,0" ToolTip="对话设置"/>
     <Button Content="⌕" Style="{StaticResource RoundIconButtonStyle}" Command="{Binding OpenPromptInspectorCommand}" Margin="0,0,8,0" ToolTip="Inspect prompt" AutomationProperties.Name="Inspect prompt"/>
     <Button Content="⇩" Style="{StaticResource RoundIconButtonStyle}" Click="ExportChat_OnClick" Margin="0,0,8,0" ToolTip="Export conversation" AutomationProperties.Name="Export conversation"/>
     <Button Content="＋" Style="{StaticResource RoundIconButtonStyle}" Command="{Binding NewChatCommand}" Margin="0,0,8,0" ToolTip="New chat" AutomationProperties.Name="New conversation"/>
     <Button Content="⋯" Style="{StaticResource RoundIconButtonStyle}" Click="DeleteChat_OnClick" ToolTip="Delete conversation" AutomationProperties.Name="Delete conversation"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- Conversation stream -->
  <Grid Grid.Row="1">
   <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,20,70" IsHitTestVisible="False">
    <Grid.Style>
     <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Messages.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
    </Grid.Style>
    <StackPanel HorizontalAlignment="Center">
     <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,18">
      <TextBlock Text="N" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="今天想聊些什么？" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/>
     <TextBlock Text="选择角色或直接输入消息，开始一段新的对话" FontSize="13" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>
   <Border Panel.ZIndex="5" Background="#FFF7D6" BorderBrush="#F0D98A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="24,16" VerticalAlignment="Top" MaxWidth="900"
           Visibility="{Binding HasProviderConfiguration, Converter={StaticResource InverseBoolToVisibility}}">
    <DockPanel><Button DockPanel.Dock="Right" Content="Open settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0"/>
     <StackPanel><TextBlock Text="Connect a model to start chatting" FontWeight="SemiBold"/><TextBlock Text="Configure a local or cloud provider in Settings." Foreground="#765F18" FontSize="12" Margin="0,3,0,0"/></StackPanel></DockPanel>
   </Border>
        <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0"
                 AutomationProperties.Name="Conversation messages"
                 Padding="0,20,0,12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.IsDeferredScrollingEnabled="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.CacheLength="1,2"
                 VirtualizingPanel.CacheLengthUnit="Page">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="20,0,20,22"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
     </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
     <DataTemplate>
      <Border x:Name="MessageBubble" Padding="16,13" CornerRadius="18" MaxWidth="820">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="Avatar" Width="44" VerticalAlignment="Top">
         <Grid Width="44" Height="44">
          <Ellipse x:Name="AvatarBackground" Fill="{StaticResource AccentBrush}"/>
          <Ellipse x:Name="CharacterAvatar" Visibility="{Binding HasAssistantAvatar, Converter={StaticResource BoolToVisibility}}">
           <Ellipse.Fill><ImageBrush ImageSource="{Binding AssistantAvatarPath}" Stretch="UniformToFill"/></Ellipse.Fill>
          </Ellipse>
          <TextBlock x:Name="AvatarLetter" Text="N" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </Grid>
         <Button x:Name="CharacterStatusButton" Content="状态" Tag="{Binding}" Click="CharacterStatus_OnClick"
                 Padding="3,2" Margin="0,5,0,0" FontSize="10"
                 ToolTip="查看 AI 生成的角色状态" AutomationProperties.Name="查看角色状态">
          <Button.Style>
           <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
               <Condition Binding="{Binding HasCharacterStatusTarget}" Value="True"/>
               <Condition Binding="{Binding DataContext.IsCharacterStatusPluginEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible"/>
             </MultiDataTrigger>
            </Style.Triggers>
           </Style>
          </Button.Style>
         </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
         <TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,7"/>
         <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}">
          <StackPanel Orientation="Horizontal" Height="24" VerticalAlignment="Center"
                      Visibility="{Binding IsWaitingForResponse, Converter={StaticResource BoolToVisibility}}">
           <TextBlock Text="正在思考" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
           <TextBlock Text="●  ●  ●" Foreground="{StaticResource AccentBrush}" FontSize="9" VerticalAlignment="Center">
            <TextBlock.Style>
             <Style TargetType="TextBlock">
              <Setter Property="Opacity" Value="0.25"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding IsWaitingForResponse}" Value="True">
                <DataTrigger.EnterActions>
                 <BeginStoryboard x:Name="WaitingPulse">
                  <Storyboard RepeatBehavior="Forever">
                   <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.65" AutoReverse="True"/>
                  </Storyboard>
                 </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="WaitingPulse"/></DataTrigger.ExitActions>
               </DataTrigger>
              </Style.Triggers>
             </Style>
            </TextBlock.Style>
           </TextBlock>
          </StackPanel>
          <controls:MarkdownViewer Markdown="{Binding Content}" FontSize="15"/>
          <ItemsControl ItemsSource="{Binding Attachments}" Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}" Margin="0,11,0,0">
           <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate><DataTemplate><Border Width="190" Height="128" CornerRadius="10" ClipToBounds="True" Background="{StaticResource PanelBrush}" Margin="0,0,8,8"><Image Source="{Binding FilePath}" Stretch="UniformToFill" ToolTip="{Binding FileName}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsStreaming, Converter={StaticResource InverseBoolToVisibility}}">
           <Button Content="Copy" Style="{StaticResource MessageActionButtonStyle}" Tag="{Binding}" Click="CopyMessage_OnClick"/>
           <Button Content="Edit" Style="{StaticResource MessageActionButtonStyle}" Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
           <Button Content="Delete" Style="{StaticResource MessageActionButtonStyle}" Tag="{Binding}" Click="DeleteMessage_OnClick"/>
           <Button Content="Branch" Style="{StaticResource MessageActionButtonStyle}"
                   Command="{Binding DataContext.BranchFromMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                   ToolTip="Create a new conversation from this message"/>
           <StackPanel Orientation="Horizontal" Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">
            <Button Content="Regenerate" Style="{StaticResource MessageActionButtonStyle}" Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <Button Content="‹" Style="{StaticResource MessageActionButtonStyle}" IsEnabled="{Binding CanSwipeLeft}" Command="{Binding DataContext.SwipeLeftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Previous variation"/>
            <TextBlock Text="{Binding SwipeDisplay}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="2,0,7,0"/>
            <Button Content="›" Style="{StaticResource MessageActionButtonStyle}" Command="{Binding DataContext.SwipeRightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Next variation"/>
           </StackPanel>
          </StackPanel>
         </StackPanel>
         <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
          <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinWidth="380" MinHeight="88" MaxHeight="220" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
           <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}" Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
           <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Margin="0" Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
          </StackPanel>
         </StackPanel>
        </StackPanel>
       </Grid>
       <Border.Style>
        <Style TargetType="Border">
         <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding Role}" Value="{x:Static models:ChatRole.User}">
           <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="{StaticResource CardBrush}"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Border.Style>
      </Border>
      <DataTemplate.Triggers>
       <DataTrigger Binding="{Binding HasAssistantAvatar}" Value="True">
        <Setter TargetName="AvatarLetter" Property="Visibility" Value="Collapsed"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding Role}" Value="{x:Static models:ChatRole.User}">
       <Setter TargetName="AvatarBackground" Property="Fill" Value="#D8DADF"/>
        <Setter TargetName="AvatarLetter" Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter TargetName="AvatarLetter" Property="Text" Value="Y"/>
       </DataTrigger>
      </DataTemplate.Triggers>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
  </Grid>

  <!-- Floating GPT-style composer -->
  <Grid Grid.Row="2" Margin="24,0,24,18">
   <Grid MaxWidth="820" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#FDECEC" BorderBrush="#F4C5C5" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" AutomationProperties.LiveSetting="Assertive">
     <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap"/>
    </Border>
    <StackPanel Grid.Row="1" Margin="0,0,0,9">
     <Border Background="#F7F7FF" BorderBrush="#DEDDF7" BorderThickness="1" CornerRadius="14" Padding="12,10"
             Visibility="{Binding HasReplySuggestions, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
       <TextBlock Text="✦ 你可以这样回应" Foreground="#5551A8" FontWeight="SemiBold" FontSize="12" Margin="2,0,0,8"/>
       <ItemsControl ItemsSource="{Binding ReplySuggestions}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Button Command="{Binding DataContext.SelectReplySuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 CommandParameter="{Binding}" Background="White" BorderBrush="#D9D8F1" Padding="11,8" Margin="0,0,8,6"
                 MaxWidth="245" HorizontalContentAlignment="Left" ToolTip="点击填入输入框">
         <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" LineHeight="18"/>
         </Button>
        </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Border>
     <Border Background="#F7F7F8" CornerRadius="12" Padding="12,8"
             Visibility="{Binding IsGeneratingSuggestions, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Orientation="Horizontal">
       <ProgressBar Width="42" Height="4" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <TextBlock Text="正在根据剧情准备 3 个回复选项…" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
      </StackPanel>
     </Border>
    </StackPanel>
    <Border Grid.Row="2" Background="White" BorderBrush="#C9CDD3" BorderThickness="1" CornerRadius="22" Padding="12,9">
     <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.12"/></Border.Effect>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ItemsControl ItemsSource="{Binding PendingImagePaths}" Margin="2,0,0,7">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><Border Background="#ECEEF0" CornerRadius="8" Padding="8,5" Margin="0,0,7,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding}" MaxWidth="220" FontSize="11" TextTrimming="CharacterEllipsis"/><Button Content="×" Style="{StaticResource GhostButtonStyle}" Padding="4,0" Margin="6,0,0,0" Command="{Binding DataContext.RemovePendingImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid Grid.Row="1">
       <TextBox x:Name="ComposerInputBox" Style="{StaticResource ComposerTextBoxStyle}" Padding="9,7" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="42" MaxHeight="160" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" PreviewKeyDown="InputBox_OnPreviewKeyDown" AllowDrop="True" Drop="InputBox_OnDrop" ToolTip="Message NativeTavern · Enter to send · Shift+Enter for new line" AutomationProperties.Name="Message input"/>
       <TextBlock Text="给 NativeTavern 发送消息" Foreground="{StaticResource MutedTextBrush}" FontSize="15" Margin="9,7" VerticalAlignment="Top" IsHitTestVisible="False">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding InputText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding InputText}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=ComposerInputBox}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Grid>
      <Grid Grid.Row="2" Margin="0,6,0,0">
       <Button HorizontalAlignment="Left" Content="＋" Style="{StaticResource RoundIconButtonStyle}" Width="32" Height="32" Background="#ECEEF0" BorderThickness="0" Click="AttachImage_OnClick" ToolTip="Attach image" AutomationProperties.Name="Attach image"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="■" Style="{StaticResource RoundIconButtonStyle}" Width="32" Height="32" FontSize="11" Background="#E3E5E8" BorderThickness="0" Command="{Binding StopCommand}" Margin="0,0,8,0" ToolTip="Stop" AutomationProperties.Name="Stop generation"/>
        <Button Content="↑" Style="{StaticResource RoundIconButtonStyle}" Width="32" Height="32" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Command="{Binding SendCommand}" ToolTip="Send" AutomationProperties.Name="Send message"/>
       </StackPanel>
      </Grid>
     </Grid>
    </Border>
    <TextBlock Grid.Row="3" Text="NativeTavern can make mistakes. Check important information." FontSize="10" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
