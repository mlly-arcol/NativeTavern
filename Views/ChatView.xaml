<UserControl x:Class="NativeTavern.Views.ChatView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="clr-namespace:NativeTavern.Models">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <ComboBox Width="250" Height="38" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" DisplayMemberPath="Title" Margin="0,0,10,0" ToolTip="切换聊天记录"/>
    <Button Content="Delete Chat" Click="DeleteChat_OnClick"/>
    <Button Content="+ New Chat" Command="{Binding NewChatCommand}" Margin="0"/>
   </StackPanel>
   <StackPanel><TextBlock Text="Chat" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding SessionTitle}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Padding="14" Margin="0,0,0,14" CornerRadius="8" Background="#302A1E" Visibility="{Binding HasProviderConfiguration, Converter={StaticResource InverseBoolToVisibility}}">
   <DockPanel><Button DockPanel.Dock="Right" Content="Go to Settings" Command="{Binding OpenSettingsCommand}"/><TextBlock Text="尚未配置模型 Provider，请先前往 Settings。" VerticalAlignment="Center"/></DockPanel>
  </Border>
  <ListBox x:Name="MessageList" Grid.Row="2" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate>
    <DataTemplate>
     <Border Padding="16,12" CornerRadius="10" MaxWidth="760">
      <Border.Style><Style TargetType="Border"><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Background" Value="{StaticResource CardBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Role}" Value="{x:Static models:ChatRole.User}"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="#3E3577"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <StackPanel>
       <TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
       <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}">
        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="15" LineHeight="22"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
         <Button Content="Copy" Padding="9,4" FontSize="11" Tag="{Binding}" Click="CopyMessage_OnClick"/>
         <Button Content="Edit" Padding="9,4" FontSize="11" Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
         <Button Content="Delete" Padding="9,4" FontSize="11" Tag="{Binding}" Click="DeleteMessage_OnClick"/>
         <StackPanel Orientation="Horizontal" Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">
          <Button Content="↻ Regenerate" Padding="9,4" FontSize="11" Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="为末尾回复生成一个新候选"/>
          <Button Content="◀" Padding="8,4" FontSize="11" IsEnabled="{Binding CanSwipeLeft}" Command="{Binding DataContext.SwipeLeftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
          <TextBlock Text="{Binding SwipeDisplay}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="2,0,10,0"/>
          <Button Content="▶" Padding="8,4" FontSize="11" Command="{Binding DataContext.SwipeRightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="切换下一候选；在末尾时生成新候选"/>
         </StackPanel>
        </StackPanel>
       </StackPanel>
       <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
        <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinWidth="360" MinHeight="80" MaxHeight="220" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
         <Button Content="Cancel" Padding="10,5" Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
         <Button Content="Save" Padding="10,5" Margin="0" Background="{StaticResource AccentBrush}" Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
        </StackPanel>
       </StackPanel>
      </StackPanel>
     </Border>
    </DataTemplate>
   </ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="3" Margin="0,16,0,0">
   <Border Background="#48262B" CornerRadius="6" Padding="10" Margin="0,0,0,10" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB8BE" TextWrapping="Wrap"/></Border>
   <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="76" MaxHeight="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" PreviewKeyDown="InputBox_OnPreviewKeyDown" ToolTip="Enter 发送，Shift+Enter 换行，Ctrl+Enter 重新生成，Esc 停止"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Stop" Command="{Binding StopCommand}"/><Button Content="Send" Command="{Binding SendCommand}" Background="{StaticResource AccentBrush}" Margin="0"/></StackPanel>
  </StackPanel>
 </Grid>
</UserControl>
