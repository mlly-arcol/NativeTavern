<UserControl x:Class="NativeTavern.Views.ChatView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="clr-namespace:NativeTavern.Models">
 <Grid Background="{StaticResource WindowBrush}">
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <!-- Compact conversation header -->
  <Border BorderBrush="#303030" BorderThickness="0,0,0,1" Padding="22,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="{Binding SessionTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
      <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBlock Text="Local workspace" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
      <TextBlock Text="  ·  ~" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
      <TextBlock Text="{Binding EstimatedPromptTokens}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
      <TextBlock Text=" tokens" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
     </StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <ComboBox Width="230" Height="38" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" DisplayMemberPath="Title" Margin="0,0,8,0" ToolTip="Switch conversation"/>
     <Button Content="⌕" Style="{StaticResource RoundIconButtonStyle}" Command="{Binding OpenPromptInspectorCommand}" Margin="0,0,8,0" ToolTip="Inspect prompt"/>
     <Button Content="＋" Style="{StaticResource RoundIconButtonStyle}" Command="{Binding NewChatCommand}" Margin="0,0,8,0" ToolTip="New chat"/>
     <Button Content="⋯" Style="{StaticResource RoundIconButtonStyle}" Click="DeleteChat_OnClick" ToolTip="Delete conversation"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- Optional prompt context controls -->
  <Border Grid.Row="1" Background="#1D1D1D" BorderBrush="#303030" BorderThickness="0,0,0,1" Padding="20,9">
   <Grid MaxWidth="980" HorizontalAlignment="Center">
    <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox ItemsSource="{Binding Personas}" SelectedItem="{Binding SelectedPersona}" DisplayMemberPath="Name" ToolTip="Persona" Margin="0,0,7,0"/>
    <ComboBox Grid.Column="1" ItemsSource="{Binding Lorebooks}" SelectedItem="{Binding SelectedLorebook}" DisplayMemberPath="Name" ToolTip="Lorebook" Margin="0,0,7,0"/>
    <ComboBox Grid.Column="2" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" ToolTip="Prompt preset" Margin="0,0,7,0"/>
    <TextBox Grid.Column="3" Text="{Binding AuthorNote,UpdateSourceTrigger=PropertyChanged}" ToolTip="Author note" Margin="0,0,7,0"/>
    <Button Grid.Column="4" Content="Apply" Command="{Binding ApplyPromptContextCommand}" Padding="12,7"/>
    <Button Grid.Column="5" Content="Clear" Command="{Binding ClearPromptContextCommand}" Style="{StaticResource GhostButtonStyle}" Padding="10,7" Margin="0"/>
   </Grid>
  </Border>

  <!-- Conversation stream -->
  <Grid Grid.Row="2">
   <Border Background="#3A2D16" CornerRadius="10" Padding="14" Margin="24,16" VerticalAlignment="Top" MaxWidth="900"
           Visibility="{Binding HasProviderConfiguration, Converter={StaticResource InverseBoolToVisibility}}">
    <DockPanel><Button DockPanel.Dock="Right" Content="Open settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0"/>
     <StackPanel><TextBlock Text="Connect a model to start chatting" FontWeight="SemiBold"/><TextBlock Text="Configure a local or cloud provider in Settings." Foreground="#D5C29B" FontSize="12" Margin="0,3,0,0"/></StackPanel></DockPanel>
   </Border>
   <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0"
            Padding="0,20,0,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="20,0,20,22"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
     </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
     <DataTemplate>
      <Border x:Name="MessageBubble" Padding="16,13" CornerRadius="18" MaxWidth="820">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Avatar" Width="28" Height="28" CornerRadius="9" Background="{StaticResource AccentBrush}" VerticalAlignment="Top">
         <TextBlock x:Name="AvatarLetter" Text="N" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0">
         <TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,7"/>
         <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="15" LineHeight="23"/>
          <ItemsControl ItemsSource="{Binding Attachments}" Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}" Margin="0,11,0,0">
           <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate><DataTemplate><Border Width="190" Height="128" CornerRadius="10" ClipToBounds="True" Background="{StaticResource PanelBrush}" Margin="0,0,8,8"><Image Source="{Binding FilePath}" Stretch="UniformToFill" ToolTip="{Binding FileName}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="-7,9,0,0" Opacity="0.72">
           <Button Content="Copy" Style="{StaticResource GhostButtonStyle}" Padding="7,4" FontSize="11" Tag="{Binding}" Click="CopyMessage_OnClick"/>
           <Button Content="Edit" Style="{StaticResource GhostButtonStyle}" Padding="7,4" FontSize="11" Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
           <Button Content="Delete" Style="{StaticResource GhostButtonStyle}" Padding="7,4" FontSize="11" Tag="{Binding}" Click="DeleteMessage_OnClick"/>
           <StackPanel Orientation="Horizontal" Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">
            <Button Content="↻" Style="{StaticResource GhostButtonStyle}" Padding="7,4" Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Regenerate"/>
            <Button Content="‹" Style="{StaticResource GhostButtonStyle}" Padding="7,4" IsEnabled="{Binding CanSwipeLeft}" Command="{Binding DataContext.SwipeLeftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <TextBlock Text="{Binding SwipeDisplay}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="2,0,4,0"/>
            <Button Content="›" Style="{StaticResource GhostButtonStyle}" Padding="7,4" Command="{Binding DataContext.SwipeRightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
           </StackPanel>
          </StackPanel>
         </StackPanel>
         <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
          <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinWidth="380" MinHeight="88" MaxHeight="220" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
           <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}" Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
           <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Margin="0" Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
          </StackPanel>
         </StackPanel>
        </StackPanel>
       </Grid>
       <Border.Style>
        <Style TargetType="Border">
         <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding Role}" Value="{x:Static models:ChatRole.User}">
           <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="{StaticResource CardBrush}"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Border.Style>
      </Border>
      <DataTemplate.Triggers>
       <DataTrigger Binding="{Binding Role}" Value="{x:Static models:ChatRole.User}">
       <Setter TargetName="Avatar" Property="Background" Value="#5A5A5A"/>
        <Setter TargetName="AvatarLetter" Property="Text" Value="Y"/>
       </DataTrigger>
      </DataTemplate.Triggers>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
  </Grid>

  <!-- Floating GPT-style composer -->
  <Grid Grid.Row="3" Margin="24,0,24,18">
   <Grid MaxWidth="820" HorizontalAlignment="Center">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#48262B" CornerRadius="8" Padding="11" Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
     <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB8BE" TextWrapping="Wrap"/>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="22" Padding="12,9">
     <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.3"/></Border.Effect>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ItemsControl ItemsSource="{Binding PendingImagePaths}" Margin="2,0,0,7">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><Border Background="#3C3C3C" CornerRadius="8" Padding="8,5" Margin="0,0,7,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding}" MaxWidth="220" FontSize="11" TextTrimming="CharacterEllipsis"/><Button Content="×" Style="{StaticResource GhostButtonStyle}" Padding="4,0" Margin="6,0,0,0" Command="{Binding DataContext.RemovePendingImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBox Grid.Row="1" Style="{StaticResource ComposerTextBoxStyle}" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="42" MaxHeight="160" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" PreviewKeyDown="InputBox_OnPreviewKeyDown" AllowDrop="True" Drop="InputBox_OnDrop" ToolTip="Message NativeTavern · Enter to send · Shift+Enter for new line"/>
      <Grid Grid.Row="2" Margin="0,6,0,0">
       <Button Content="＋" Style="{StaticResource RoundIconButtonStyle}" Width="32" Height="32" Background="#3B3B3B" BorderThickness="0" Click="AttachImage_OnClick" ToolTip="Attach image"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="■" Style="{StaticResource RoundIconButtonStyle}" Width="32" Height="32" FontSize="11" Background="#454545" BorderThickness="0" Command="{Binding StopCommand}" Margin="0,0,8,0" ToolTip="Stop"/>
        <Button Content="↑" Style="{StaticResource RoundIconButtonStyle}" Width="32" Height="32" Background="{StaticResource TextBrush}" Foreground="#202020" BorderThickness="0" Command="{Binding SendCommand}" ToolTip="Send"/>
       </StackPanel>
      </Grid>
     </Grid>
    </Border>
    <TextBlock Grid.Row="2" Text="NativeTavern can make mistakes. Check important information." FontSize="10" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
