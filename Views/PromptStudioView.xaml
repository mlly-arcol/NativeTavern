<UserControl x:Class="NativeTavern.Views.PromptStudioView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="Prompt Studio" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Manage Personas, Lorebooks and Prompt Presets. Applied content is sent to your configured model Provider." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
  <TabControl Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}">
   <TabItem Header="Personas">
    <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel><Button DockPanel.Dock="Bottom" Content="+ New Persona" Command="{Binding NewPersonaCommand}" Margin="0,10,0,0"/><ListBox ItemsSource="{Binding Personas}" SelectedItem="{Binding SelectedPersona}" DisplayMemberPath="Name"/></DockPanel>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="Name"/><TextBox Text="{Binding PersonaName,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/></StackPanel>
      <StackPanel Grid.Row="1"><TextBlock Text="Persona Content"/><TextBox Text="{Binding PersonaContent,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,12"/></StackPanel>
      <StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="Save" Command="{Binding SavePersonaCommand}" Background="{StaticResource AccentBrush}"/><Button Content="Delete" Click="DeletePersona_OnClick" Background="#63343A"/></StackPanel>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="Lorebooks">
    <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition Width="280"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel><Button DockPanel.Dock="Bottom" Content="+ New Lorebook" Command="{Binding NewLorebookCommand}" Margin="0,10,0,0"/><ListBox ItemsSource="{Binding Lorebooks}" SelectedItem="{Binding SelectedLorebook}" DisplayMemberPath="Name"/></DockPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="Lorebook Name"/><TextBox Text="{Binding LorebookName,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,10"/>
      <TextBlock Text="Description"/><TextBox Text="{Binding LorebookDescription,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" Margin="0,6,0,10"/>
      <CheckBox Content="Enabled" IsChecked="{Binding LorebookEnabled}" Foreground="{StaticResource TextBrush}" Margin="2,4,0,12"/>
      <StackPanel Orientation="Horizontal"><Button Content="Save" Command="{Binding SaveLorebookCommand}" Background="{StaticResource AccentBrush}"/><Button Content="Delete" Click="DeleteLorebook_OnClick" Background="#63343A"/></StackPanel>
      <Separator Margin="0,18"/>
      <TextBlock Text="Entries" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding LoreEntries}" SelectedItem="{Binding SelectedLoreEntry}" DisplayMemberPath="Name" Height="180" Margin="0,8,0,8"/>
      <Button Content="+ New Entry" Command="{Binding NewLoreEntryCommand}"/>
     </StackPanel>
     <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="Entry Name"/><TextBox Text="{Binding EntryName,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,9"/>
      <TextBlock Text="Primary Keywords (comma separated)"/><TextBox Text="{Binding EntryKeywords,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,9"/>
      <TextBlock Text="Secondary Keywords"/><TextBox Text="{Binding EntrySecondaryKeywords,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,9"/>
      <TextBlock Text="Content"/><TextBox Text="{Binding EntryContent,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" Margin="0,5,0,9"/>
      <StackPanel Orientation="Horizontal"><TextBlock Text="Priority" VerticalAlignment="Center"/><TextBox Text="{Binding EntryPriority}" Width="70" Margin="8,0,18,0"/><TextBlock Text="Depth" VerticalAlignment="Center"/><TextBox Text="{Binding EntryDepth}" Width="70" Margin="8,0,0,0"/></StackPanel>
      <WrapPanel Margin="0,12"><CheckBox Content="Enabled" IsChecked="{Binding EntryEnabled}" Foreground="{StaticResource TextBrush}" Margin="0,0,16,0"/><CheckBox Content="Constant" IsChecked="{Binding EntryConstant}" Foreground="{StaticResource TextBrush}" Margin="0,0,16,0"/><CheckBox Content="Selective" IsChecked="{Binding EntrySelective}" Foreground="{StaticResource TextBrush}"/></WrapPanel>
      <StackPanel Orientation="Horizontal"><Button Content="Save Entry" Command="{Binding SaveLoreEntryCommand}" Background="{StaticResource AccentBrush}"/><Button Content="Delete Entry" Click="DeleteLoreEntry_OnClick" Background="#63343A"/></StackPanel>
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>
   <TabItem Header="Prompt Presets">
    <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel><Button DockPanel.Dock="Bottom" Content="+ New Preset" Command="{Binding NewPresetCommand}" Margin="0,10,0,0"/><ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"/></DockPanel>
     <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="Name"/><TextBox Text="{Binding PresetName,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,9"/>
      <TextBlock Text="System Prompt"/><TextBox Text="{Binding SystemPrompt,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" Margin="0,5,0,9"/>
      <TextBlock Text="Main Prompt"/><TextBox Text="{Binding MainPrompt,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" Margin="0,5,0,9"/>
      <TextBlock Text="Model override (optional)"/><TextBox Text="{Binding PresetModel,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,9"/>
      <StackPanel Orientation="Horizontal"><TextBlock Text="Temperature" VerticalAlignment="Center"/><TextBox Text="{Binding PresetTemperature}" Width="80" Margin="8,0,16,0"/><TextBlock Text="Top P" VerticalAlignment="Center"/><TextBox Text="{Binding PresetTopP}" Width="80" Margin="8,0,16,0"/><TextBlock Text="Max Tokens" VerticalAlignment="Center"/><TextBox Text="{Binding PresetMaxTokens}" Width="90" Margin="8,0,0,0"/></StackPanel>
      <TextBlock Text="Leave overrides blank to use Settings values." Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,14"/>
      <StackPanel Orientation="Horizontal"><Button Content="Save" Command="{Binding SavePresetCommand}" Background="{StaticResource AccentBrush}"/><Button Content="Delete" Click="DeletePreset_OnClick" Background="#63343A"/></StackPanel>
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0"/>
 </Grid>
</UserControl>
