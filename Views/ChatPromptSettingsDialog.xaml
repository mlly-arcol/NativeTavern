<Window x:Class="NativeTavern.Views.ChatPromptSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="对话设置" Width="560" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" PreviewKeyDown="Dialog_OnPreviewKeyDown">
 <Grid Margin="18">
  <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
          CornerRadius="16" Padding="26,24,26,22">
   <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.20" Color="#32000000"/></Border.Effect>
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Width="42" Height="4" CornerRadius="2" Background="#151515" HorizontalAlignment="Left"/>
    <TextBlock Grid.Row="1" Text="对话设置" Margin="0,17,0,0" FontSize="21" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="2" Text="调整仅用于当前对话的可选上下文。" Margin="0,7,0,0"
               Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>

    <Grid Grid.Row="3" Margin="0,22,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,6,0">
      <TextBlock Text="Persona" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <ComboBox x:Name="PersonaBox" Height="38" ItemsSource="{Binding Personas}" DisplayMemberPath="Name"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Margin="6,0">
      <TextBlock Text="Lorebook" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <ComboBox x:Name="LorebookBox" Height="38" ItemsSource="{Binding Lorebooks}" DisplayMemberPath="Name"/>
     </StackPanel>
     <StackPanel Grid.Column="2" Margin="6,0,0,0">
      <TextBlock Text="Prompt preset" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <ComboBox x:Name="PresetBox" Height="38" ItemsSource="{Binding Presets}" DisplayMemberPath="Name"/>
     </StackPanel>
    </Grid>

    <TextBlock Grid.Row="4" Text="作者备注" FontWeight="SemiBold" Margin="0,22,0,8"/>
    <TextBox x:Name="AuthorNoteBox" Grid.Row="5" AcceptsReturn="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" Padding="12,10" MaxLength="4000"/>

    <StackPanel Grid.Row="6" Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="取消" MinWidth="88" Padding="18,10" Margin="0" IsCancel="True"/>
     <Button Content="清除" MinWidth="88" Padding="18,10" Margin="10,0,0,0" Click="Clear_OnClick"/>
     <Button Content="应用" MinWidth="96" Padding="18,10" Margin="10,0,0,0"
             Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="Apply_OnClick"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
