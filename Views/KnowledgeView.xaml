<UserControl x:Class="NativeTavern.Views.KnowledgeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="28" AllowDrop="True" Drop="KnowledgeView_OnDrop">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Import Documents" Click="Import_OnClick"/><Button Content="Delete" Click="Delete_OnClick" Background="#63343A" Margin="0"/></StackPanel><StackPanel><TextBlock Text="Knowledge Base" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Drop or import TXT, Markdown and PDF files. Context sharing stays disabled until enabled in Settings." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14"><ListBox ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding ManagedPath}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding ChunkCount, StringFormat={}{0} chunks}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Grid.Column="2" Text="Enabled" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Opacity" Value="0.35"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="Foreground" Value="#79D2A6"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Enable / Disable Selected" Click="Toggle_OnClick"/><TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0"/></StackPanel>
 </Grid>
</UserControl>
