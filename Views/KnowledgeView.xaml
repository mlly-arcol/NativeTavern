<UserControl x:Class="NativeTavern.Views.KnowledgeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="28" AllowDrop="True" Drop="KnowledgeView_OnDrop">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="Import Documents" Click="Import_OnClick"/>
    <Button Content="Delete" Click="Delete_OnClick" Margin="0">
     <Button.Style>
      <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
       <Setter Property="Background" Value="#FFF3F2"/>
       <Setter Property="Foreground" Value="#B42318"/>
       <Setter Property="BorderBrush" Value="#F1C6C2"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedDocument}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
       </Style.Triggers>
      </Style>
     </Button.Style>
    </Button>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="Knowledge Base" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Text="Drop or import TXT, Markdown and PDF files. Context sharing stays disabled until enabled in Settings."
               Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
   </StackPanel>
  </DockPanel>

  <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
   <Grid>
    <ListBox x:Name="DocumentList" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" Background="Transparent" BorderThickness="0">
     <ListBox.ItemTemplate>
      <DataTemplate>
       <Grid Margin="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding ManagedPath}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding ChunkCount, StringFormat={}{0} chunks}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
        <TextBlock Grid.Column="2" Text="Enabled" VerticalAlignment="Center" HorizontalAlignment="Right">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Opacity" Value="0.35"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="Foreground" Value="#18864B"/></DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </Grid>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
     <StackPanel.Style>
      <Style TargetType="StackPanel">
       <Style.Triggers>
        <DataTrigger Binding="{Binding HasItems, ElementName=DocumentList}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
       </Style.Triggers>
      </Style>
     </StackPanel.Style>
     <TextBlock Text="No documents yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
     <TextBlock Text="Drop TXT, Markdown or PDF files here, or choose Import Documents."
                Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center" Margin="0,7,0,16"/>
     <Button Content="Import Documents" Click="Import_OnClick" HorizontalAlignment="Center" Margin="0"/>
    </StackPanel>
   </Grid>
  </Border>

  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
   <Button Content="Enable / Disable Selected" Click="Toggle_OnClick">
    <Button.Style>
     <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Style.Triggers>
       <DataTrigger Binding="{Binding SelectedDocument}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
      </Style.Triggers>
     </Style>
    </Button.Style>
   </Button>
   <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0"/>
  </StackPanel>
 </Grid>
</UserControl>
