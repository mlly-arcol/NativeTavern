<Window x:Class="NativeTavern.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NativeTavern" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBox x:Name="ValueTextBox" Grid.Row="1" MinHeight="40" VerticalContentAlignment="Center"
                 AutomationProperties.Name="Conversation title"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True"/>
            <Button Content="保存" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Margin="0"
                    Click="Save_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
