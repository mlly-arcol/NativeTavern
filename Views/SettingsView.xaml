<UserControl x:Class="NativeTavern.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="SettingsTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="SettingsDescription" TargetType="TextBlock" BasedOn="{StaticResource PageSubtitleStyle}"><Setter Property="Margin" Value="0,4,0,18"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="SettingsLabel" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/></Style>
 </UserControl.Resources>
 <Grid Margin="30,26,30,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}"/>
   <TextBlock Text="Configure model connections, generation behavior and context privacy." Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,18">
   <StackPanel MaxWidth="880" HorizontalAlignment="Left">
    <Border Style="{StaticResource SurfaceBorderStyle}" Padding="22" Margin="0,0,0,14">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Grid.ColumnSpan="2" Text="Interface" Style="{StaticResource SettingsTitle}"/>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Choose the language used throughout NativeTavern." Style="{StaticResource SettingsDescription}"/>
      <TextBlock Grid.Row="2" Text="Interface Language" Style="{StaticResource SettingsLabel}"/>
      <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="DisplayName"/>
     </Grid>
    </Border>
    <Border Style="{StaticResource SurfaceBorderStyle}" Padding="22" Margin="0,0,0,14">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Grid.ColumnSpan="2" Text="Provider connection" Style="{StaticResource SettingsTitle}"/>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Connect to an OpenAI-compatible, cloud or local model service." Style="{StaticResource SettingsDescription}"/>
      <TextBlock Grid.Row="2" Text="Provider" Style="{StaticResource SettingsLabel}"/>
      <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ProviderProfiles}" SelectedItem="{Binding SelectedProvider}" DisplayMemberPath="DisplayName" Margin="0,0,0,12"/>
      <TextBlock Grid.Row="3" Text="Base URL" Style="{StaticResource SettingsLabel}"/>
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BaseUrl,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
      <TextBlock Grid.Row="4" Text="API Key" Style="{StaticResource SettingsLabel}"/>
      <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_OnPasswordChanged"/>
       <Button Grid.Column="1" Content="Clear" Command="{Binding ClearApiKeyCommand}" Margin="8,0,0,0"/>
      </Grid>
      <TextBlock Grid.Row="5" Text="Model" Style="{StaticResource SettingsLabel}"/>
      <Grid Grid.Row="5" Grid.Column="1">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox IsEditable="True" ItemsSource="{Binding AvailableModels}" DisplayMemberPath="Id" TextSearch.TextPath="Id" Text="{Binding Model,UpdateSourceTrigger=PropertyChanged}"/>
       <Button Grid.Column="1" Content="Discover Models" Command="{Binding DiscoverModelsCommand}" Margin="8,0,0,0"/>
      </Grid>
     </Grid>
    </Border>
    <Border Style="{StaticResource SurfaceBorderStyle}" Padding="22" Margin="0,0,0,14">
     <StackPanel>
      <TextBlock Text="Generation" Style="{StaticResource SettingsTitle}"/>
      <TextBlock Text="Tune response creativity and request size." Style="{StaticResource SettingsDescription}"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="Temperature" Style="{StaticResource SettingsLabel}"/>
       <TextBox Grid.Column="1" Text="{Binding Temperature,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,18,12" ToolTip="0 to 2"/>
       <TextBlock Grid.Column="2" Text="Top P" Style="{StaticResource SettingsLabel}"/>
       <TextBox Grid.Column="3" Text="{Binding TopP,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" ToolTip="0 to 1"/>
       <TextBlock Grid.Row="1" Text="Max Tokens" Style="{StaticResource SettingsLabel}"/>
       <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxTokens,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,18,0" ToolTip="Greater than 0"/>
       <TextBlock Grid.Row="1" Grid.Column="2" Text="Context Length" Style="{StaticResource SettingsLabel}"/>
       <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ContextLength,UpdateSourceTrigger=PropertyChanged}" ToolTip="Reference context window; local server context size is configured by the server"/>
      </Grid>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource SurfaceBorderStyle}" Padding="22" Margin="0,0,0,14">
     <StackPanel>
      <TextBlock Text="Context privacy" Style="{StaticResource SettingsTitle}"/>
      <TextBlock Text="Choose which local content may be included in model requests." Style="{StaticResource SettingsDescription}"/>
      <CheckBox Content="Include the selected character card and First Message in model requests" IsChecked="{Binding IncludeCharacterContext}" Margin="2,0,0,15"/>
      <CheckBox Content="Allow matched knowledge-base excerpts to be sent in model requests" IsChecked="{Binding IncludeKnowledgeContext}" Margin="2,0,0,15"/>
      <CheckBox Content="Allow attached images to be sent in model requests" IsChecked="{Binding IncludeImageContext}" Margin="2,0,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource SurfaceBorderStyle}" Padding="22">
     <StackPanel>
      <TextBlock Text="Local model runtime" Style="{StaticResource SettingsTitle}"/>
      <TextBlock Text="Discover running services or start a GGUF model with llama.cpp." Style="{StaticResource SettingsDescription}"/>
      <CheckBox Content="Scan local services at startup" IsChecked="{Binding AutoScanLocalModels}" Margin="2,0,0,16"/>
      <TextBlock Text="GGUF model files" FontWeight="SemiBold" Margin="2,0,0,7"/>
      <Grid Margin="0,0,0,16">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox ItemsSource="{Binding LocalModels}" SelectedItem="{Binding SelectedLocalModel}" DisplayMemberPath="DisplayName"/>
       <Button Grid.Column="1" Content="Start and Connect" Command="{Binding StartSelectedLocalModelCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/>
      </Grid>
      <TextBlock Text="Running local services" FontWeight="SemiBold" Margin="2,0,0,7"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox ItemsSource="{Binding DetectedServices}" SelectedItem="{Binding SelectedDetectedService}" DisplayMemberPath="DisplayName"/>
       <Button Grid.Column="1" Content="Scan Local" Command="{Binding ScanLocalCommand}" Margin="8,0,8,0"/>
       <Button Grid.Column="2" Content="Use Selected" Command="{Binding UseDetectedServiceCommand}" Margin="0"/>
      </Grid>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14">
   <Grid>
    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,0,220,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="Test Connection" Command="{Binding TestConnectionCommand}"/>
     <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
