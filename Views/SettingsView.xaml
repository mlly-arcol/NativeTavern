<UserControl x:Class="NativeTavern.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="36" MaxWidth="760" HorizontalAlignment="Left">
  <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Grid.ColumnSpan="2" Text="Settings" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,26"/>
  <TextBlock Grid.Row="1" Text="Provider" VerticalAlignment="Center" Margin="0,0,20,14"/><TextBlock Grid.Row="1" Grid.Column="1" Text="OpenAI Compatible" FontWeight="SemiBold" Margin="0,8,0,14"/>
  <TextBlock Grid.Row="2" Text="Base URL" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
  <TextBlock Grid.Row="3" Text="API Key" VerticalAlignment="Center"/><Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_OnPasswordChanged"/><Button Grid.Column="1" Content="Clear" Command="{Binding ClearApiKeyCommand}" Margin="8,0,0,0"/></Grid>
  <TextBlock Grid.Row="4" Text="Model" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
  <TextBlock Grid.Row="5" Text="Temperature" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
  <TextBlock Grid.Row="6" Text="Top P" VerticalAlignment="Center"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TopP, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
  <TextBlock Grid.Row="7" Text="Max Tokens" VerticalAlignment="Center"/><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>
  <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal"><Button Content="Test Connection" Command="{Binding TestConnectionCommand}"/><Button Content="Save" Command="{Binding SaveCommand}" Background="{StaticResource AccentBrush}"/></StackPanel>
  <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding StatusMessage}" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
  <TextBlock Grid.Row="10" Grid.ColumnSpan="2" Margin="0,32,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="API Key 使用 Windows DPAPI 加密，仅当前 Windows 用户可以解密。日志不会记录 API Key 或完整聊天内容。"/>
 </Grid></ScrollViewer>
</UserControl>
